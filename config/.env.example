# --- DATABASE CONFIGURATION ---
# Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/dashboard_matkul

# Supabase PostgreSQL (Standard/Session Mode)
# Gunakan port 5432 untuk server Express/Node.js yang berjalan terus-menerus
# Ganti [project-ref] dan [password] dengan kredensial Supabase milikmu
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- SUPABASE API CONFIGURATION ---
# Dibutuhkan untuk Supabase Storage (upload file) dan fitur Supabase lainnya
# Dapatkan dari: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=[anon-key-dari-dashboard-supabase]

# --- SERVER CONFIGURATION ---
PORT=3000
NODE_ENV=development
