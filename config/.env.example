# --- DATABASE CONFIGURATION ---
# Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/dashboard_matkul

# Neon PostgreSQL (Pooled Connection - recommended for serverless)
# Dapatkan dari: Neon Dashboard → Connection String → Pooled connection
# Format: postgresql://user:password@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:[password]@ep-xxx-pooler.us-east-1.neon.tech/neondb?sslmode=require

# --- VERCEL BLOB CONFIGURATION ---
# Token untuk Vercel Blob Storage (file upload)
# Di production di Vercel, token ini otomatis tersedia
# Untuk lokal dev, dapatkan dari: Vercel Dashboard → Project Settings → Storage → BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- AUTH CONFIGURATION ---
# Wajib di production. Gunakan secret random minimal 32 karakter.
JWT_SECRET=replace-with-a-long-random-secret

# --- SERVER CONFIGURATION ---
PORT=3000
NODE_ENV=development
